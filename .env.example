# Browser-safe Supabase values.
# These values are embedded in the Vite browser bundle and are not secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Shows "Sign in with Microsoft" and the staff sign-in settings. Turn on
# only after the Entra app registration and the Supabase Azure provider
# (with the MoF tenant URL) are set up for this environment.
VITE_MICROSOFT_SIGN_IN=false

# Server-only Supabase values. Never prefix these values with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Server-only signing secret for returning-visitor verification tokens.
VISITOR_LOOKUP_SECRET=your_visitor_lookup_signing_secret

# Server-only. The Ministry's public outbound IP addresses, separated by
# commas: exact addresses or IPv4 ranges such as 196.10.20.0/28. Staff
# APIs refuse requests from anywhere else. Empty means no restriction,
# except on Vercel Production, where empty refuses all staff requests.
STAFF_ALLOWED_IPS=

# Canonical staff sign-in URL included in staff onboarding emails.
STAFF_LOGIN_URL=http://localhost:3000/staff/login

# Guest Wi-Fi: the network name shown and sent to visitors, and a
# secret of at least 32 bytes used to encrypt guest passwords until
# they expire.
WIFI_NETWORK_NAME=MoF-Guest
# Per-tower guest networks; Tower 1 defaults to "PEACE - HUB - Guest".
WIFI_NETWORK_NAME_TOWER_1=
WIFI_NETWORK_NAME_TOWER_2=
WIFI_PASSWORD_SECRET=

# Returning visitors confirm their number with an SMS code only when
# RETURNING_SMS_CODES=on. Left off, the mobile number alone finds the
# visitor's record.
RETURNING_SMS_CODES=

# Server-only SMS for returning-visitor codes: hubtel or arkesel.
# Leave SMS_PROVIDER empty outside Production to log codes on the server
# instead of sending them. Production without a provider shows
# "Returning check-in is unavailable. Please ask reception."
SMS_PROVIDER=
SMS_SENDER_ID=MoF-Visitor
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
# Short address for SMS feedback links (<base>/f/<code>). Empty uses
# https://mofv.vercel.app; set the Ministry's short domain here later.
FEEDBACK_SHORT_LINK_BASE=

# Server-only Ministry or organizational SMTP configuration.
# Use port 465 with SMTP_SECURE=true or port 587 with SMTP_SECURE=false.
# The same mailbox Supabase Auth uses. Set SMTP_PASSWORD yourself in
# Vercel; never commit it. Microsoft is retiring password sign-in for
# SMTP; the follow-up is sending through Microsoft Graph instead.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTPNotifications@mofep.gov.gh
SMTP_PASSWORD=
SMTP_FROM_EMAIL=SMTPNotifications@mofep.gov.gh
SMTP_FROM_NAME=Client Service Unit

# Minimum 32-byte secret used to derive weekly visitor QR tokens.
WEEKLY_QR_SECRET=

# Canonical visitor application origin without a trailing slash.
# Example: https://visitors.example.gov.gh
VISITOR_APP_URL=
# Public Microsoft Entra IDs for the meeting booking page (/book).
# Bookers sign in with their work email; the API checks the ID token
# against this tenant and client. Not secrets.
VITE_ENTRA_TENANT_ID=your_entra_tenant_id
VITE_ENTRA_CLIENT_ID=your_entra_app_client_id
