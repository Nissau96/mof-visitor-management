# Browser-safe Supabase values.
# These values are embedded in the Vite browser bundle and are not secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Server-only Supabase values. Never prefix these values with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Server-only signing secret for returning-visitor verification tokens.
VISITOR_LOOKUP_SECRET=your_visitor_lookup_signing_secret

# Canonical staff sign-in URL included in staff onboarding emails.
STAFF_LOGIN_URL=http://localhost:3000/staff/login

# Server-only Ministry or organizational SMTP configuration.
# Use port 465 with SMTP_SECURE=true or port 587 with SMTP_SECURE=false.
SMTP_HOST=your_organizational_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_organizational_smtp_username
SMTP_PASSWORD=your_organizational_smtp_password
SMTP_FROM_EMAIL=your_approved_sender@example.gov.gh
SMTP_FROM_NAME=MoF Visitor Management

# Minimum 32-byte secret used to derive weekly visitor QR tokens.
WEEKLY_QR_SECRET=

# Canonical visitor application origin without a trailing slash.
# Example: https://visitors.example.gov.gh
VISITOR_APP_URL=